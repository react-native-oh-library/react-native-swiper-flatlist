<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <oatconfig>
	<licensefile>LICENSE</licensefile>
    <policylist>
        <policy name="projectPolicy" desc="">
            <policyitem type="license" name="MIT" path=".*" desc="license under the MIT"/>
        </policy>
        <policy name="projectPolicy" desc="">
            <policyitem type="compatibility" name="GPL-2.0+" path=".*" desc="Process that runs independently, invoked by the X process."/>
            <policyitem type="compatibility" name="Apache-2.0" path=".*" desc="不影响兼容性"/>
            <policyitem type="compatibility" name="BSDStyleLicense" path=".*" desc="不影响兼容性" />
            <policyitem type="compatibility" name="MIT" path=".*" desc="不影响兼容性" />
            <policyitem type="compatibility" name="GPLStyleLicense" path=".*" desc="不影响兼容性" />
        </policy>
    </policylist>
        <filefilterlist>
            <filefilter name="copyrightPolicyFilter" desc="Filters for compatibility，license header policies">
                <filteritem type="filepath" name=".npmignore" desc="发布忽略配置"/>
                <filteritem type="filepath" name="example/.*" desc="示例工程文件"/>
                <filteritem type="filepath" name="old-rn-example/.*" desc="旧示例工程文件"/>
                <filteritem type="filepath" name="src/.*" desc="源码目录文件"/>
                <filteritem type="filepath" name="WithGestureHandler.tsx" desc="入口辅助文件"/>
                <filteritem type="filepath" name="index.ts" desc="库导出入口"/>
                <filteritem type="filepath" name="babel.config.js" desc="构建配置文件"/>
                <filteritem type="filepath" name="yarn.lock" desc="依赖锁定文件"/>
            </filefilter>
            <filefilter name="defaultPolicyFilter" desc="Filters for compatibility，license header policies">
                <filteritem type="filepath" name=".npmignore" desc="发布忽略配置"/>
                <filteritem type="filepath" name="example/.*" desc="示例工程文件"/>
                <filteritem type="filepath" name="old-rn-example/.*" desc="旧示例工程文件"/>
                <filteritem type="filepath" name="src/.*" desc="源码目录文件"/>
                <filteritem type="filepath" name="WithGestureHandler.tsx" desc="入口辅助文件"/>
                <filteritem type="filepath" name="index.ts" desc="库导出入口"/>
                <filteritem type="filepath" name="babel.config.js" desc="构建配置文件"/>
                <filteritem type="filepath" name="yarn.lock" desc="依赖锁定文件"/>
            </filefilter>
            <filefilter name="binaryFileTypePolicyFilter" desc="Filters for binary file policies">
                <filteritem type="filename" name="*.png" desc="png图片格式文件,用于展示示例图"/>
                <filteritem type="filename" name="*.jpg" desc="jpg图片格式文件,用于展示示例图"/>
                <filteritem type="filename" name="*.jpeg" desc="jpeg图片格式文件,用于展示示例图"/>
                <filteritem type="filename" name="*.gif" desc="gif动图文件,用于演示效果"/>
                <filteritem type="filename" name="*.jar" desc="jar归档文件,用于构建工具"/>
                <filteritem type="filename" name="*.keystore" desc="keystore密钥文件,用于签名调试"/>
            </filefilter>
        </filefilterlist>
    </oatconfig>
</configuration>
